---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsFeed from "@/components/NewsFeed.astro";
import { profile } from "@/data/profile";
---

<BaseLayout title={`News | ${profile.name}`} description="Updates on research, service, and milestones.">
  <section class="news-page section">
    <div class="container news-page-header">
      <p class="eyebrow">News</p>
      <h1>Posts and milestones</h1>
      <p class="news-page-lede">
        Short updates on papers, reviewing, talks, and other news — same feed as the homepage, with room to
        grow.
      </p>
    </div>
    <div class="container">
      <NewsFeed />
    </div>
  </section>
</BaseLayout>

<style>
  .news-page-header {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .news-page-header h1 {
    margin: 0 0 0.65rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 760;
    line-height: 1.05;
  }

  .news-page-lede {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }
</style>
