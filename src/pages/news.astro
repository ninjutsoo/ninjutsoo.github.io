---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsFeed from "@/components/NewsFeed.astro";
import { profile } from "@/data/profile";
---

<BaseLayout title={`News | ${profile.name}`} description="Updates on research, service, and milestones.">
  <section class="news-page section">
    <div class="container news-page-header">
      <h1>News</h1>
    </div>
    <div class="container">
      <NewsFeed compact />
    </div>
  </section>
</BaseLayout>

<style>
  .news-page-header {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .news-page-header h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 760;
    line-height: 1.05;
  }
</style>
