---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignHome from "@/components/DesignHome.astro";
import { profile } from "@/data/profile";

export function getStaticPaths() {
  return ["academic", "modern", "editorial", "experimental"].map((variant) => ({
    params: { variant },
  }));
}

const variant = Astro.params.variant as "academic" | "modern" | "editorial" | "experimental";
const labels = {
  academic: "Academic",
  modern: "Modern",
  editorial: "Editorial",
  experimental: "Experimental",
};
---

<BaseLayout
  title={`${profile.name} | ${labels[variant]} Website Preview`}
  description={`${labels[variant]} homepage layout preview for ${profile.name}.`}
>
  <DesignHome variant={variant} />
</BaseLayout>
