---
import { getCollection } from "astro:content";
import { sitePath } from "@/utils/paths";
import { formatPostDate, postExcerpt, postHref, postTitle } from "@/utils/news";

interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit, showViewAll = false } = Astro.props;

const entries = (await getCollection("updates")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const visible = limit ? entries.slice(0, limit) : entries;
---

<div class="news-feed">
  {visible.length === 0 ? (
    <p class="feed-empty">No posts yet. Add a markdown file under <code>src/content/updates/</code>.</p>
  ) : (
    <>
      {visible.map((entry) => {
        const href = postHref(entry);
        const title = postTitle(entry);
        return (
          <article class:list={["feed-teaser card", entry.data.image && "has-thumb"]}>
            <div class="feed-teaser-layout">
              {entry.data.image && (
                <a class="feed-thumb" href={href} tabindex="-1" aria-hidden="true">
                  <img
                    src={sitePath(entry.data.image)}
                    alt=""
                    width="120"
                    height="72"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="feed-teaser-copy">
                <p class="feed-meta">
                  <time datetime={entry.data.date}>{formatPostDate(entry.data.date)}</time>
                  {entry.data.tag && <span class="feed-tag">{entry.data.tag}</span>}
                </p>
                <h3 class="feed-title">
                  <a href={href}>{title}</a>
                </h3>
                <p class="feed-excerpt">{postExcerpt(entry)}</p>
                <a class="feed-continue" href={href} aria-label={`Read full post: ${title}`}>
                  Read post
                </a>
              </div>
            </div>
          </article>
        );
      })}
      {showViewAll && limit !== undefined && entries.length > limit && (
        <p class="feed-more">
          <a class="text-link" href={sitePath("/news")}>All posts</a>
        </p>
      )}
    </>
  )}
</div>

<style>
  .news-feed {
    display: grid;
    gap: 0.85rem;
  }

  .feed-teaser {
    padding: 1rem 1.1rem 1.05rem;
  }

  .feed-teaser-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .feed-teaser.has-thumb .feed-teaser-layout {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem 1rem;
    align-items: start;
  }

  .feed-thumb {
    display: block;
    flex-shrink: 0;
    line-height: 0;
  }

  .feed-thumb img {
    display: block;
    width: clamp(4.25rem, 16vw, 6.75rem);
    height: auto;
    max-height: 4.5rem;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 0.3rem;
  }

  .feed-teaser-copy {
    min-width: 0;
  }

  .feed-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    align-items: center;
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 620;
  }

  .feed-tag {
    color: var(--accent);
    font-weight: 720;
  }

  .feed-tag::before {
    content: "·";
    margin-right: 0.65rem;
    color: var(--muted);
    font-weight: 500;
  }

  .feed-title {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 720;
    line-height: 1.32;
  }

  .feed-title a {
    color: inherit;
    text-decoration: none;
  }

  .feed-title a:hover {
    color: var(--accent);
  }

  .feed-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .feed-continue {
    display: inline-block;
    margin-top: 0.65rem;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 720;
    text-decoration: none;
  }

  .feed-continue:hover {
    text-decoration: underline;
  }

  .feed-more {
    margin: 0.25rem 0 0;
    text-align: center;
  }

  .feed-empty {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .feed-empty code {
    font-size: 0.88em;
  }
</style>
